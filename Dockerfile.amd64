FROM debian:bookworm-slim AS fetcher
ARG AGAVE_VERSION=3.1.11
ARG AGAVE_AMD64_SHA256=5978d621fe2582fc2403fa13f3c06502020bcb42e806ddd4612150049d1a3fbb
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates bzip2 && \
    rm -rf /var/lib/apt/lists/*
RUN curl -fLo /tmp/agave.tar.bz2 \
      "https://github.com/anza-xyz/agave/releases/download/v${AGAVE_VERSION}/solana-release-x86_64-unknown-linux-gnu.tar.bz2" && \
    echo "${AGAVE_AMD64_SHA256}  /tmp/agave.tar.bz2" | sha256sum -c - && \
    tar -xjf /tmp/agave.tar.bz2 -C /tmp && \
    mv /tmp/solana-release/bin/solana-test-validator /solana-test-validator && \
    chmod +x /solana-test-validator && \
    rm /tmp/agave.tar.bz2

FROM debian:bookworm-slim
RUN apt-get update && \
    apt-get install -y --no-install-recommends libssl3 ca-certificates && \
    rm -rf /var/lib/apt/lists/*
COPY --from=fetcher /solana-test-validator /usr/local/bin/solana-test-validator
ENTRYPOINT ["/usr/local/bin/solana-test-validator"]
